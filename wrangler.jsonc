{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "love-letter-official",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_NAME": "Love Letter",
    "BOT_USERNAME": "loveletter_official_bot",
    "MONTHLY_FREE_LIMIT": "3",
    "LETTER_PRICE_XTR": "29",
    "AUTH_MAX_AGE_SECONDS": "86400",
    "DEV_BYPASS_AUTH": "false",
    "APP_ORIGIN": "https://REPLACE_WITH_WORKER_DOMAIN.workers.dev",
    "SUPPORT_CONTACT": "@replace_support"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "love-letter-official-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
