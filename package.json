{
  "name": "love-letter-official",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply love-letter-official-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply love-letter-official-db --remote",
    "bot:setup": "node scripts/setup-bot.mjs",
    "test:unit": "node tests/backend.test.mjs",
    "test:browser": "node tests/ui.test.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "test:syntax": "node --check worker/index.js && node --check worker/telegram.js && node --check public/app.js && node --check public/telegram-bridge.js",
    "check:config": "node scripts/check-config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "wrangler": "^4.68.0"
  }
}
